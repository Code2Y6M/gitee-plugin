{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "description": "owner/repo or a Gitee URL. Defaults to the current project's Gitee remote."
    },
    "state": {
      "type": "string",
      "enum": ["open", "merged", "closed", "all"],
      "default": "open",
      "description": "Which pull requests to list."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20,
      "description": "How many pull requests to return."
    }
  },
  "additionalProperties": false
}
